# Generate unique values with: openssl rand -base64 32
APP_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
APP_SESSION_KEY=replace-with-a-different-base64-encoded-32-byte-key
# Any non-whitespace password is supported, including values from `openssl rand -base64 32`.
POSTGRES_PASSWORD=change-this-local-postgres-password
PROJECT_ROOT=/data/users
RUNTIME_IMAGE=atoms-runtime:latest
DATA_VOLUME_NAME=atoms-data
RUNTIME_NETWORK=atoms-internal
